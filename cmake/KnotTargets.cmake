if(TARGET Knot::Shared)
    return()
endif()
add_library(Knot::Shared SHARED IMPORTED)
add_library(Knot::Static STATIC IMPORTED)
add_library(Knot::CppShared STATIC IMPORTED)
add_library(Knot::CppStatic STATIC IMPORTED)
foreach(_target IN ITEMS Shared Static CppShared CppStatic)
    set_target_properties(Knot::${_target} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_Knot_prefix}/include")
endforeach()
if(WIN32)
    set_target_properties(Knot::Shared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/bin/knot.dll"
        IMPORTED_IMPLIB "${_Knot_prefix}/lib/shared/knot.lib")
    set_target_properties(Knot::Static PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/static/knot.lib"
        INTERFACE_LINK_LIBRARIES "bcrypt;advapi32;legacy_stdio_definitions;kernel32;ntdll;userenv;ws2_32;dbghelp"
        INTERFACE_LINK_OPTIONS "/defaultlib:msvcrt")
    set_target_properties(Knot::CppShared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/knot_cpp_shared.lib")
    set_target_properties(Knot::CppStatic PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/knot_cpp_static.lib")
elseif(APPLE)
    set_target_properties(Knot::Shared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/libknot.dylib")
    set_target_properties(Knot::Static PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/static/libknot.a"
        INTERFACE_LINK_LIBRARIES "-framework Security;-framework CoreFoundation;iconv;System;c;m")
    set_target_properties(Knot::CppShared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/libknot_cpp_shared.a")
    set_target_properties(Knot::CppStatic PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/libknot_cpp_static.a")
else()
    set_target_properties(Knot::Shared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/libknot.so")
    set_target_properties(Knot::Static PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/static/libknot.a"
        INTERFACE_LINK_LIBRARIES "gcc_s;util;rt;pthread;m;dl;c")
    set_target_properties(Knot::CppShared PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/libknot_cpp_shared.a")
    set_target_properties(Knot::CppStatic PROPERTIES IMPORTED_LOCATION "${_Knot_prefix}/lib/cpp/libknot_cpp_static.a")
endif()
set_target_properties(Knot::Static PROPERTIES INTERFACE_COMPILE_DEFINITIONS KNOT_STATIC)
set_target_properties(Knot::CppShared PROPERTIES INTERFACE_LINK_LIBRARIES Knot::Shared INTERFACE_COMPILE_FEATURES cxx_std_17)
set_target_properties(Knot::CppStatic PROPERTIES INTERFACE_LINK_LIBRARIES Knot::Static INTERFACE_COMPILE_FEATURES cxx_std_17)
unset(_target)
